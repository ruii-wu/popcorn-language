# SQLite local DB
DATABASE_URL="file:./dev.db"

# Ollama local HTTP API
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"

# Optional: smaller / faster fallback model for correction & suggestions
OLLAMA_MODEL_LIGHT="qwen2.5:3b-instruct"

# Request timeout for a single LLM call (ms)
OLLAMA_TIMEOUT_MS=60000
